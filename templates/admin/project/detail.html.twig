{% extends '@EasyAdmin/crud/detail.html.twig' %}


{% block detail_fields %}
    {% set project = entity.instance %}
    {% set statusColor = constant('App\\Controller\\Admin\\ProjectCrudController::STATUS_BADGES')[project.status.name] %}

    <div class="d-flex flex-wrap align-items-center gap-4 mb-3">
        <div>
            <span class="text-body-secondary me-1">{{ 'entities.App\\Entity\\Project.properties.team'|trans }}:</span>
            <a href="{{ path('admin_team_detail', {entityId: project.team.id})}}">{{ project.team }}</a>
        </div>
        <div>
            <span class="text-body-secondary me-1">{{ 'entities.App\\Entity\\Project.properties.status'|trans }}:</span>
            <twig:ea:Badge variant="{{ statusColor }}">{{ project.status|trans }}</twig:ea:Badge>
        </div>
    </div>

    {% if project.description %}
        <div class="mb-4">
            {{ project.description|raw }}
        </div>
    {% endif %}

    <div class="row g-3">
        {% for status in enum_cases('App\\Enum\\TaskStatus') %}
            {% set tasks = project.tasks|filter(task => task.status == status) %}

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        {{ status|trans }}
                        <twig:ea:Badge variant="secondary">{{ tasks|length }}</twig:ea:Badge>
                    </div>

                    <ul class="list-group list-group-flush">
                        {% for task in tasks %}
                            {% set priorityColor = constant('App\\Controller\\Admin\\TaskCrudController::PRIORITY_BADGES')[task.priority.name] %}
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <a href="{{ path('admin_task_detail', {entityId: task.id}) }}">{{ task.title }}</a>
                                    <twig:ea:Badge variant="{{ priorityColor }}">{{ task.priority|trans }}</twig:ea:Badge>
                                </div>
                                <div class="d-flex justify-content-between small text-body-secondary">
                                    <div>{{ task.assignee ?? '–' }}</div>
                                    {% if task.dueDate %}
                                        <div>{{ task.dueDate|format_date('medium') }}</div>
                                    {% endif %}
                                </div>
                            </li>
                        {% else %}
                            <li class="list-group-item text-body-secondary">
                                {{ 'project.detail.no_tasks'|trans }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}



