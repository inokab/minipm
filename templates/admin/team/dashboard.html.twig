{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ team.name }} – {{ 'team.dashboard.title'|trans }}{% endblock %}

{% block main %}
    {% set statusBadges = constant('App\\Controller\\Admin\\TaskCrudController::STATUS_BADGES') %}
    {% set statusIcons = {Todo: 'fa-regular fa-circle', InProgress: 'fa-solid fa-rotate', Done: 'fa-regular fa-circle-check'} %}
    {% set overdueColor = stats.overdueTasks > 0 ? 'danger' : 'success' %}

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <div class="text-body-secondary">{{ 'team.dashboard.active_projects'|trans }}</div>
                    <div class="fs-1 fw-bold text-primary">{{ stats.activeProjects }}</div>
                    <div class="text-body-secondary">{{ 'team.dashboard.all_projects'|trans({'%count%': stats.totalProjects}) }}</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-body-secondary">{{ 'team.dashboard.total_tasks'|trans }}</div>
                    <div class="fs-1 fw-bold">{{ stats.totalTasks }}</div>
                    <div class="text-body-secondary">{{ 'team.dashboard.open_tasks'|trans({'%count%': stats.openTasks}) }}</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-body-secondary">{{ 'team.dashboard.completion'|trans }}</div>
                    <div class="fs-1 fw-bold text-success">{{ stats.completion|format_percent_number }}</div>
                    <div class="progress" role="progressbar" aria-label="{{ 'team.dashboard.completion'|trans }}"
                         aria-valuenow="{{ (stats.completion * 100)|round }}" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-success" style="width: {{ stats.completion * 100 }}%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100 border-{{ overdueColor }}">
                <div class="card-body">
                    <div class="text-body-secondary">{{ 'team.dashboard.overdue'|trans }}</div>
                    <div class="fs-1 fw-bold text-{{ overdueColor }}">{{ stats.overdueTasks }}</div>
                    <div class="text-body-secondary">{{ 'team.dashboard.overdue_hint'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header fw-semibold">
                    <twig:ea:Icon name="fa-solid fa-chart-simple" class="me-1" />
                    {{ 'team.dashboard.tasks_by_status'|trans }}
                </div>
                <div class="card-body">
                    {% if stats.totalTasks > 0 %}
                        <div class="progress-stacked mb-3">
                            {% for status in enum_cases('App\\Enum\\TaskStatus') %}
                                {% set ratio = stats.ratiosByStatus[status.value] %}
                                <div class="progress" role="progressbar" style="width: {{ ratio * 100 }}%"
                                     aria-label="{{ status|trans }}" aria-valuenow="{{ (ratio * 100)|round }}" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-{{ statusBadges[status.name] }}"></div>
                                </div>
                            {% endfor %}
                        </div>

                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'entities.App\\Entity\\Task.properties.status'|trans }}</th>
                                    <th class="text-end">{{ 'team.dashboard.count'|trans }}</th>
                                    <th class="text-end">{{ 'team.dashboard.share'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for status in enum_cases('App\\Enum\\TaskStatus') %}
                                    <tr>
                                        <td>
                                            <twig:ea:Icon name="{{ statusIcons[status.name] }}" class="text-{{ statusBadges[status.name] }} me-1" />
                                            {{ status|trans }}
                                        </td>
                                        <td class="text-end fw-bold">{{ stats.countsByStatus[status.value] }}</td>
                                        <td class="text-end text-body-secondary">
                                            {{ stats.ratiosByStatus[status.value]|format_percent_number({max_fraction_digit: 1}) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-body-secondary mb-0">{{ 'team.dashboard.no_tasks'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% set projectBadges = constant('App\\Controller\\Admin\\ProjectCrudController::STATUS_BADGES') %}
    {% set roleBadges = constant('App\\Controller\\Admin\\UserCrudController::ROLE_BADGES') %}

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span><twig:ea:Icon name="fa fa-folder" class="me-1" /> {{ 'entities.App\\Entity\\Project.plural'|trans }}</span>
                    <twig:ea:Badge variant="secondary">{{ projects|length }}</twig:ea:Badge>
                </div>
                <ul class="list-group list-group-flush">
                    {% for item in projects %}
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span>
                                    <a href="{{ path('admin_project_detail', {entityId: item.project.id}) }}">{{ item.project.title }}</a>
                                    <twig:ea:Badge variant="{{ projectBadges[item.project.status.name] }}" class="ms-1">{{ item.project.status|trans }}</twig:ea:Badge>
                                </span>
                                <span class="small text-body-secondary text-nowrap">
                                    {% if item.totalTasks > 0 %}
                                        {{ 'team.dashboard.project_tasks'|trans({'%done%': item.doneTasks, '%total%': item.totalTasks}) }}
                                        · <span class="fw-bold text-success">{{ item.completion|format_percent_number }}</span>
                                    {% else %}
                                        {{ 'project.detail.no_tasks'|trans }}
                                    {% endif %}
                                </span>
                            </div>
                            {% if item.totalTasks > 0 %}
                                <div class="progress mt-2" role="progressbar" style="height: .5rem" aria-label="{{ item.project.title }}"
                                     aria-valuenow="{{ (item.completion * 100)|round }}" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: {{ item.completion * 100 }}%"></div>
                                </div>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="list-group-item text-body-secondary">{{ 'team.dashboard.no_projects'|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span><twig:ea:Icon name="fa fa-user" class="me-1" /> {{ 'entities.App\\Entity\\Team.properties.members'|trans }}</span>
                    <twig:ea:Badge variant="secondary">{{ team.members|length }}</twig:ea:Badge>
                </div>
                <ul class="list-group list-group-flush">
                    {% for member in team.members|sort((a, b) => a.name <=> b.name) %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {{ member.name }}
                                <span class="d-block small text-body-secondary">{{ member.email }}</span>
                            </span>
                            <twig:ea:Badge variant="{{ roleBadges[member.role.name] }}">{{ member.role|trans }}</twig:ea:Badge>
                        </li>
                    {% else %}
                        <li class="list-group-item text-body-secondary">{{ 'team.dashboard.no_members'|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
